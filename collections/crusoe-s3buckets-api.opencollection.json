{
  "opencollection": "1.0.0",
  "info": {
    "name": "Crusoe S3 Buckets API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "S3Buckets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all S3 buckets in the project and returns their details.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.crusoe.ai/v1/projects/:project_id/storage/s3/buckets",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the project that owns the buckets."
              },
              {
                "name": "next_page_token",
                "value": "bXktZmlyc3Qtdm0",
                "type": "query",
                "description": "Token that returns the next page of results."
              },
              {
                "name": "prev_page_token",
                "value": "bXktZmlyc3Qtdm0",
                "type": "query",
                "description": "Token that returns the previous page of results."
              },
              {
                "name": "page_size",
                "value": "10",
                "type": "query",
                "description": "Maximum number of buckets to return per page."
              }
            ]
          },
          "docs": "Lists all S3 buckets in the project and returns their details."
        },
        {
          "info": {
            "name": "Creates an S3 bucket in the project and returns the created bucket.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.crusoe.ai/v1/projects/:project_id/storage/s3/buckets",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the project to create the bucket in."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an S3 bucket in the project and returns the created bucket."
        },
