{
  "opencollection": "1.0.0",
  "info": {
    "name": "Crusoe Snapshots API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Snapshots",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all disk snapshots in the project and returns their details.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.crusoe.ai/v1/projects/:project_id/storage/snapshots",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              }
            ]
          },
          "docs": "Size of snapshots will be in bytes."
        },
        {
          "info": {
            "name": "Creates a disk snapshot in the project and returns the async operation.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.crusoe.ai/v1/projects/:project_id/storage/snapshots",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "A successful response from this resource will contain the async operation."
        },
        {
          "info": {
            "name": "Returns details for a single disk snapshot in the project.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.crusoe.ai/v1/projects/:project_id/storage/snapshots/:snapshot_id",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the project that owns the disk snapshot."
              },
              {
                "name": "snapshot_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the disk snapshot."
              }
            ]
          },
          "docs": "Size of snapshot will be in bytes."
        },
        {
          "info": {
            "name": "Renames a disk snapshot in the project and returns the updated snapshot.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.cloud.crusoe.ai/v1/projects/:project_id/storage/snapshots/:snapshot_id",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the project that owns the disk snapshot."
              },
              {
                "name": "snapshot_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the disk snapshot."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "A successful response from this resource will contain the updated snapshot."
        },
        {
          "info": {
            "name": "Deletes a disk snapshot from the project and returns the async operation.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloud.crusoe.ai/v1/projects/:project_id/storage/snapshots/:snapshot_id",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the project that owns the disk snapshot."
              },
              {
                "name": "snapshot_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path",
                "description": "ID of the disk snapshot."
              }
            ]
          },
          "docs": "A successful response from this resource will contain the async operation."
        }
      ]
    }
  ],
  "bundled": true
}