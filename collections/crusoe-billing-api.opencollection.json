{
  "opencollection": "1.0.0",
  "info": {
    "name": "Crusoe Billing API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Billing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the daily spend for a specified organization by project.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.crusoe.ai/v1/organizations/:organization_id/billing/costs",
            "params": [
              {
                "name": "organization_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              }
            ]
          },
          "docs": "Get the daily spend for a specified organization by project."
        },
        {
          "info": {
            "name": "Return a CSV containing the costs for resources in a given period.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.crusoe.ai/v1/organizations/:organization_id/billing/export-productline",
            "params": [
              {
                "name": "organization_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              },
              {
                "name": "projects",
                "value": "d8f58dfd-dd86-4ee4-8f01-643e6d0f15bb",
                "type": "query"
              },
              {
                "name": "product_lines",
                "value": "persistent-ssd,a40",
                "type": "query"
              },
              {
                "name": "regions",
                "value": "us-east1,us-northcentral1",
                "type": "query"
              },
              {
                "name": "start_date",
                "value": "\"2022-07-01\"",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "\"2023-08-08\"",
                "type": "query"
              }
            ]
          },
          "docs": "Return a CSV containing the costs for resources in a given period."
        },
        {
          "info": {
            "name": "Retrieve data about an organizations recent Non-Reservation costs.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.crusoe.ai/v1/organizations/:organization_id/billing/options",
            "params": [
              {
                "name": "organization_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              },
              {
                "name": "start_date",
                "value": "\"2025-05-01\"",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "\"2025-05-20\"",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve data about an organizations recent Non-Reservation costs."
        }
      ]
    }
  ],
  "bundled": true
}